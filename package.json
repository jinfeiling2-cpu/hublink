{
  "name": "hublink",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 43123",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 43123",
    "lint": "eslint",
    "test": "tsx --test src/domain/*.test.ts src/content/*.test.ts src/agents/*.test.ts",
    "corpus:run": "node --import tsx src/agents/run-local.ts",
    "corpus:check": "node --import tsx src/agents/check-local.ts",
    "github:read": "python3 scripts/read-github.py",
    "github:draft": "node --import tsx scripts/build-github-draft.ts",
    "github:import": "node --import tsx scripts/import-github-reading.ts",
    "corpus:model": "node --import tsx src/agents/run-model.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@next/env": "15.5.28",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "d3-force": "^3.0.0",
    "lucide-react": "^1.60.0",
    "next": "15.5.28",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.22.1",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
