# 后台口令。不设置时，仅开发模式使用 dev-hublink-admin。
ADMIN_PASSWORD=

# 用来签名登录状态。生产环境请换成一段随机字符串。
SESSION_SECRET=

# 可选。读取私有 GitHub 仓库时使用，只需要内容的只读权限。
GITHUB_TOKEN=

# Optional server-side corpus extraction. Disabled by default.
# Also requires an explicit corpus:model --execute invocation.
CORPUS_MODEL_ENABLED=false
OPENAI_API_KEY=
# Choose a model that supports Responses API structured JSON output.
CORPUS_MODEL=
# Stable public website address used by the resume QR code.
# Leave empty until a phone-accessible deployment URL is available.
NEXT_PUBLIC_SITE_URL=
